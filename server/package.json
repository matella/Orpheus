{
  "name": "orpheus-server",
  "version": "0.1.0",
  "description": "Orpheus — Autonomous Adaptive Music Intelligence Server",
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=node --experimental-sqlite --watch src/index.ts",
    "start": "node --experimental-sqlite dist/index.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
